{
  "Urls": "http://0.0.0.0:8080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Device": {
    "Id": "enclosurehub",
    "Name": "Printer Enclosure",
    "Manufacturer": "DIY",
    "Model": "Raspberry Pi 2 Model B"
  },

  "Web": {
    "Dashboard": {
      "Enabled": true
    },
    "Auth": {
      "Username": "",
      "Password": ""
    }
  },

  "Modules": {
    "Camera": {
      "Enabled": true,
      "Active": true,
      "Id": "camera",
      "Name": "Camera",
      "Executable": "rpicam-vid",
      "Width": 1640,
      "Height": 1232,
      "Framerate": 1,
      "Quality": 85,
      "Rotation": 0,
      "ExtraArgs": "",
      "RestartDelaySeconds": 5,
      "StaleAfterSeconds": 15
    },
    "Timelapse": {
      "Enabled": true,
      "Id": "timelapse",
      "Name": "Timelapse",
      "CameraId": "camera",
      "TurnCameraOn": true,
      "IntervalSeconds": 30,
      "MaxDurationHours": 48,
      "VideoFps": 30,
      "Encoder": "libx264",
      "Crf": 23,
      "HardwareBitrate": "10M",
      "Directory": "timelapse",
      "FfmpegExecutable": "ffmpeg",
      "MinFreeMegabytes": 300
    },
    "SystemSensors": {
      "Enabled": true,
      "IntervalSeconds": 30
    }
  },

  "Mqtt": {
    "Enabled": true,
    "Host": "",
    "Port": 1883,
    "Username": "",
    "Password": "",
    "DiscoveryPrefix": "homeassistant",
    "CameraImageIntervalSeconds": 5,
    "CameraMode": "Image",
    "PublicUrl": "",
    "ReconnectDelaySeconds": 10
  }
}
