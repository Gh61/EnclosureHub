{
  "Urls": "http://0.0.0.0:8080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Device": {
    "Id": "enclosurehub",
    "Name": "Printer Enclosure",
    "Manufacturer": "DIY",
    "Model": "Raspberry Pi 2 Model B"
  },

  "Modules": {
    "Camera": {
      "Enabled": true,
      "Id": "camera",
      "Name": "Camera",
      "Executable": "rpicam-vid",
      "Width": 1640,
      "Height": 1232,
      "Framerate": 1,
      "Quality": 85,
      "ExtraArgs": "",
      "RestartDelaySeconds": 5,
      "StaleAfterSeconds": 15
    },
    "SystemSensors": {
      "Enabled": true,
      "IntervalSeconds": 30
    }
  },

  "Mqtt": {
    "Enabled": true,
    "Host": "",
    "Port": 1883,
    "Username": "",
    "Password": "",
    "DiscoveryPrefix": "homeassistant",
    "CameraImageIntervalSeconds": 5,
    "ReconnectDelaySeconds": 10
  }
}
