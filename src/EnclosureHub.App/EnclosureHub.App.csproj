<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>EnclosureHub.App</RootNamespace>
    <AssemblyName>enclosurehub</AssemblyName>
    <Version>0.3.0</Version>

    <!-- Raspberry Pi 2 has 1 GB RAM and 4 slow cores: workstation GC without background GC saves memory -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- No libicu needed on Raspberry Pi OS Lite -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- RuntimeIdentifier is intentionally NOT set here so the app can be debugged on Windows.
         Publish with: dotnet publish src/EnclosureHub.App -c Release -r linux-arm self-contained -->

    <!-- The web dashboard (Vue + TypeScript + SCSS) lives in Dashboard/ and is built with Vite into wwwroot/.
         Its sources and node_modules are not project items; wwwroot is generated (see BuildDashboard). -->
    <DashboardDir>$(MSBuildProjectDirectory)/Dashboard/</DashboardDir>
    <DefaultItemExcludes>$(DefaultItemExcludes);Dashboard/**;wwwroot/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local overrides live only on the device; never overwrite them on deploy -->
    <Content Update="appsettings.Local.json;appsettings.Local.example.json" CopyToPublishDirectory="Never" />
    <!-- Timelapse data when running locally (Modules:Timelapse:Directory) -->
    <Content Remove="timelapse/**" />
    <None Remove="timelapse/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EnclosureHub.Tests" />
  </ItemGroup>

  <ItemGroup>
    <DashboardSource Include="Dashboard/src/**;Dashboard/public/**;Dashboard/index.html;Dashboard/package.json;Dashboard/package-lock.json;Dashboard/vite.config.ts;Dashboard/tsconfig.json" />
  </ItemGroup>

  <!-- npm is needed on the build machine (never on the Pi). Packages are installed once; the dashboard is rebuilt
       only when a source changed. `npm run build` also type-checks the templates (vue-tsc). -->
  <Target Name="RestoreDashboard" Condition="!Exists('$(DashboardDir)node_modules')">
    <Message Importance="high" Text="Installing dashboard npm packages…" />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(DashboardDir)" />
  </Target>

  <Target Name="BuildDashboard" BeforeTargets="BeforeBuild" DependsOnTargets="RestoreDashboard" Inputs="@(DashboardSource)" Outputs="wwwroot/index.html">
    <Message Importance="high" Text="Building the dashboard (Vite)…" />
    <Exec Command="npm run build" WorkingDirectory="$(DashboardDir)" />
  </Target>

  <!-- wwwroot is generated after the project was evaluated, so add it to the publish output explicitly -->
  <Target Name="PublishDashboard" AfterTargets="ComputeFilesToPublish" DependsOnTargets="BuildDashboard">
    <ItemGroup>
      <DashboardOutput Include="wwwroot/**" />
      <ResolvedFileToPublish Include="@(DashboardOutput)" RelativePath="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\EnclosureHub.Core\EnclosureHub.Core.csproj" />
    <ProjectReference Include="..\EnclosureHub.Camera\EnclosureHub.Camera.csproj" />
    <ProjectReference Include="..\EnclosureHub.Printer\EnclosureHub.Printer.csproj" />
    <ProjectReference Include="..\EnclosureHub.Timelapse\EnclosureHub.Timelapse.csproj" />
    <ProjectReference Include="..\EnclosureHub.Mqtt\EnclosureHub.Mqtt.csproj" />
  </ItemGroup>

</Project>
